# Copiar a .env y completar. El .env real NO va al repo.

GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Motor del asistente: 0.6b | 1.7b | 4b (Qwen3 local) | groq (API)
JARVIS_LLM=4b

# --- Pensamiento del modelo -------------------------------------------------
# JARVIS_THINK=1               bloque <think> prendido. 0 lo apaga.
# JARVIS_THINK_TOPE=80         techo del <think>, en tokens. 0 = sin techo.
#                              Medido: sin techo el pensamiento era el 94% del
#                              turno (292 tokens pensando, 17 contestando).
# JARVIS_THINK_TOPE_CACHE=24   techo cuando el pensamiento vino del cache.
# JARVIS_THINK_PREFIJO=...     arranque del <think>, ya escrito. Va en ingles a
#                              proposito: Qwen razona mejor en su idioma de
#                              entrenamiento.
# JARVIS_PENS_UMBRAL=0.90      similitud minima para reusar un pensamiento.

# --- Vision -----------------------------------------------------------------
# JARVIS_CAM_FPS=10            cadencia de la camara.
# JARVIS_DET_HZ=5              cadencia de deteccion de YOLO.

# --- Base de datos ----------------------------------------------------------
# DATABASE_URL=postgresql://jarvis:jarvis123@localhost/jarvis
